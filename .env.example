# Copy this file to .env and fill in your values
# Chat model provider
FEATHERLESS_API_KEY=your-featherless-key-here
FEATHERLESS_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Speech-to-text.
# auto uses remote STT when STT_API_KEY or GROQ_API_KEY is set, otherwise local Whisper.
STT_PROVIDER=auto
STT_API_KEY=gsk_your-stt-key-here
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
GROQ_API_KEY=gsk_your-groq-key-here

# Local German fallback via multilingual Whisper.
LOCAL_STT_MODEL=onnx-community/whisper-base
TRANSFORMERS_CACHE=
FFMPEG_PATH=

# Text-to-speech via CambAI
CAMB_API_KEY=your-camb-key-here
CAMB_VOICE_ID=147320

# Optional: default path to your Obsidian vault
OBSIDIAN_VAULT_PATH=/Users/yourname/Documents/Obsidian
